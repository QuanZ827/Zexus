<UserControl x:Class="Zexus.Views.Controls.InputBarControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <!-- InputBar TextBox style (Step 7 consolidates into Styles.xaml) -->
        <Style x:Key="InputTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#0DFFFFFF"/>
            <Setter Property="Foreground" Value="#E8EAED"/>
            <Setter Property="BorderBrush" Value="#18FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontFamily" Value="Google Sans, Segoe UI Variable, Segoe UI, Segoe UI Emoji"/>
            <Setter Property="CaretBrush" Value="#E8EAED"/>
            <Setter Property="SelectionBrush" Value="#4285F4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="InputBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="InputBorder" Property="BorderBrush" Value="#404285F4"/>
                                <Setter TargetName="InputBorder" Property="Background" Value="#12FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Send Button: Stitch blue→purple→pink gradient with neon glow -->
        <Style x:Key="SendButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="SendBorder" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#4D8EFE" Offset="0"/>
                                    <GradientStop Color="#A855F7" Offset="0.5"/>
                                    <GradientStop Color="#E14EF6" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="18" ShadowDepth="0" Opacity="0.40" Color="#A855F7"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SendBorder" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#5A95F5" Offset="0"/>
                                            <GradientStop Color="#B868FF" Offset="0.5"/>
                                            <GradientStop Color="#EF60FF" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="SendBorder" Property="Background" Value="#1AFFFFFF"/>
                                <Setter Property="Foreground" Value="#4DFFFFFF"/>
                                <Setter TargetName="SendBorder" Property="Effect" Value="{x:Null}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <!-- Image preview thumbnails (visible only when PendingImages.Count > 0) -->
        <Border x:Name="ImagePreviewBar" Padding="8,6" Background="#08FFFFFF" Visibility="Collapsed">
            <StackPanel x:Name="ImagePreviewPanel" Orientation="Horizontal"/>
        </Border>

        <!-- Input bar -->
        <Border x:Name="InputBarBorder" CornerRadius="0,0,15,15"
                Padding="14,10,14,14" Background="#0AFFFFFF">
            <Border.BorderBrush>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#00FFFFFF" Offset="0"/>
                    <GradientStop Color="#10FFFFFF" Offset="0.5"/>
                    <GradientStop Color="#00FFFFFF" Offset="1"/>
                </LinearGradientBrush>
            </Border.BorderBrush>
            <Border.BorderThickness><Thickness Top="1"/></Border.BorderThickness>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="MessageInput" Grid.Column="0"
                         AcceptsReturn="True" TextWrapping="Wrap"
                         MaxHeight="100" VerticalScrollBarVisibility="Auto"
                         Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                         IsEnabled="{Binding IsInputEnabled}"
                         KeyDown="OnInputKeyDown"
                         PreviewKeyDown="OnInputPreviewKeyDown"
                         Style="{StaticResource InputTextBoxStyle}"/>
                <Button x:Name="SendBtn" Grid.Column="1"
                        Content="↑" FontWeight="Bold"
                        Command="{Binding SendCommand}"
                        Style="{StaticResource SendButtonStyle}" Margin="8,0,0,0"/>
            </Grid>
        </Border>
    </StackPanel>
</UserControl>
