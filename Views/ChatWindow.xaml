<Window x:Class="Zexus.Views.ChatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Zexus.Views.Controls"
        xmlns:views="clr-namespace:Zexus.Views"
        Title="Zexus (Testing)"
        Width="1200" Height="750"
        MinWidth="480" MinHeight="500"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResizeWithGrip"
        Topmost="False">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Zexus;component/Resources/Styles.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/Zexus;component/Views/Templates/MessageTemplates.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- ═══════════════════════════════════════════════════
                 ZEXUS — GLASSMORPHISM
                 Brand: #4285F4 Blue → #7B61FF Purple
                 Base: #08090D cool black  |  Text: #E8EAED cool white
                 ═══════════════════════════════════════════════════ -->

        <Style x:Key="HeaderButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#5F6368"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1AFFFFFF"/>
                                <Setter Property="Foreground" Value="#E8EAED"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#5F6368"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#EA4335"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="InputTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#0DFFFFFF"/>
            <Setter Property="Foreground" Value="#E8EAED"/>
            <Setter Property="BorderBrush" Value="#18FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontFamily" Value="Google Sans, Segoe UI Variable, Segoe UI, Segoe UI Emoji"/>
            <Setter Property="CaretBrush" Value="#E8EAED"/>
            <Setter Property="SelectionBrush" Value="#4285F4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="InputBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="InputBorder" Property="BorderBrush" Value="#404285F4"/>
                                <Setter TargetName="InputBorder" Property="Background" Value="#12FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Send: gradient blue→purple with glow -->
        <Style x:Key="SendButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="SendBorder" CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#4285F4" Offset="0"/>
                                    <GradientStop Color="#7B61FF" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="14" ShadowDepth="0" Opacity="0.30" Color="#7B61FF"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SendBorder" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#5A95F5" Offset="0"/>
                                            <GradientStop Color="#9B85FF" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="SendBorder" Property="Background" Value="#1AFFFFFF"/>
                                <Setter Property="Foreground" Value="#4DFFFFFF"/>
                                <Setter TargetName="SendBorder" Property="Effect" Value="{x:Null}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="5"/>
            <Setter Property="MinWidth" Value="5"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0">
                                        <RepeatButton.Template>
                                            <ControlTemplate><Border Background="Transparent"/></ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#30FFFFFF" CornerRadius="2.5" Margin="1,0" Opacity="0.4"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0">
                                        <RepeatButton.Template>
                                            <ControlTemplate><Border Background="Transparent"/></ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Height" Value="5"/>
                    <Setter Property="MinHeight" Value="5"/>
                    <Setter Property="Width" Value="Auto"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        </ResourceDictionary>
    </Window.Resources>

    <!-- OUTER SHELL: gradient border + blue-purple ambient glow -->
    <Border x:Name="OuterShellBorder" CornerRadius="16" Padding="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="44" ShadowDepth="0" Opacity="0.10" Color="#7B61FF"/>
        </Border.Effect>
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#204285F4" Offset="0"/>
                <GradientStop Color="#08FFFFFF" Offset="0.5"/>
                <GradientStop Color="#157B61FF" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>

        <Border x:Name="MainBgBorder" Background="#121317" CornerRadius="15">
            <Grid>
                <!-- Step 7 ambient orbs: blue top-left + pink center-right (per Stitch spec) -->
                <Canvas IsHitTestVisible="False" ClipToBounds="True">
                    <Ellipse Width="640" Height="640" Canvas.Left="-220" Canvas.Top="-220">
                        <Ellipse.Fill>
                            <RadialGradientBrush>
                                <GradientStop Color="#264D8EFE" Offset="0"/>   <!-- blue at ~15% -->
                                <GradientStop Color="#004D8EFE" Offset="1"/>
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>
                    <Ellipse Width="520" Height="520" Canvas.Right="-180" Canvas.Top="120">
                        <Ellipse.Fill>
                            <RadialGradientBrush>
                                <GradientStop Color="#1FE14EF6" Offset="0"/>   <!-- pink at ~12% -->
                                <GradientStop Color="#00E14EF6" Offset="1"/>
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>
                    <Ellipse Width="380" Height="380" Canvas.Right="-100" Canvas.Bottom="-160">
                        <Ellipse.Fill>
                            <RadialGradientBrush>
                                <GradientStop Color="#1A7B61FF" Offset="0"/>   <!-- subtle purple at ~10% -->
                                <GradientStop Color="#007B61FF" Offset="1"/>
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>
                </Canvas>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="44"/>      <!-- Title -->
                        <RowDefinition Height="Auto"/>    <!-- (collapsed DocLabelBar placeholder) -->
                        <RowDefinition Height="*"/>       <!-- Content + Sidebar -->
                        <RowDefinition Height="Auto"/>    <!-- Selection Inspector -->
                        <RowDefinition Height="Auto"/>    <!-- InputBarControl -->
                    </Grid.RowDefinitions>

                    <!-- TITLE BAR (logo + name + version + doc context + window chrome) -->
                    <controls:TitleBarControl Grid.Row="0" DataContext="{Binding TitleBar}"/>

                    <!-- (former DocLabelBar row — doc info moved into TitleBarControl) -->
                    <Border x:Name="DocLabelBar" Grid.Row="1" Background="Transparent" Visibility="Collapsed"/>

                    <!-- CONTENT AREA: Sidebar (56px) | Chat + Workspace + Output -->
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="56"/>
                            <ColumnDefinition Width="*" MinWidth="360"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="420" MinWidth="280"/>
                        </Grid.ColumnDefinitions>

                        <controls:SidebarControl Grid.Column="0" DataContext="{Binding Sidebar}"/>

                        <!-- Right-panel splitter (between chat and right panel) -->
                        <GridSplitter Grid.Column="2" Width="4" Background="#15FFFFFF"
                                      HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                      ShowsPreview="False"/>

                        <controls:RightPanelControl Grid.Column="3" DataContext="{Binding RightPanel}"/>

                        <Grid Grid.Column="1">
                        <Grid Grid.Column="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <ScrollViewer x:Name="ChatScrollViewer" Grid.Row="0"
                                          VerticalScrollBarVisibility="Auto" Background="Transparent" Padding="16,10,16,10"
                                          ScrollChanged="ChatScrollViewer_OnScrollChanged">
                                <StackPanel x:Name="ChatContainer">
                                    <Border CornerRadius="16" Padding="24,20" Margin="32,16,32,16"
                                            HorizontalAlignment="Center" BorderThickness="1" BorderBrush="#12FFFFFF">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="#0EFFFFFF" Offset="0"/>
                                                <GradientStop Color="#06FFFFFF" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <StackPanel HorizontalAlignment="Center">
                                            <!-- Gradient accent bar -->
                                            <Border Width="32" Height="3" CornerRadius="1.5" HorizontalAlignment="Center" Margin="0,0,0,14">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                        <GradientStop Color="#4285F4" Offset="0"/>
                                                        <GradientStop Color="#7B61FF" Offset="0.5"/>
                                                        <GradientStop Color="#D946EF" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                            </Border>
                                            <TextBlock Text="Welcome to Zexus" FontSize="16" FontWeight="SemiBold"
                                                       Foreground="#E8EAED" TextAlignment="Center" Margin="0,0,0,2"
                                                       FontFamily="Google Sans, Segoe UI Variable, Segoe UI, Segoe UI Emoji"/>
                                            <TextBlock Text="v0.3.0" FontSize="9" FontWeight="SemiBold" TextAlignment="Center"
                                                       Foreground="#7B61FF" Margin="0,0,0,10"
                                                       FontFamily="Google Sans, Segoe UI Variable, Segoe UI, Segoe UI Emoji"/>
                                            <TextBlock TextWrapping="Wrap" Foreground="#50FFFFFF" FontSize="12" TextAlignment="Left" LineHeight="20"
                                                       FontFamily="Google Sans, Segoe UI Variable, Segoe UI, Segoe UI Emoji">
                                                Describe what you need in plain language — the AI agent writes and executes Revit API code to accomplish it.
                                            </TextBlock>
                                            <Border CornerRadius="6" Background="#08FFFFFF" Padding="12,8" Margin="0,10,0,0">
                                                <TextBlock TextWrapping="Wrap" Foreground="#40FFFFFF" FontSize="11" LineHeight="18"
                                                           FontFamily="Google Sans, Segoe UI Variable, Segoe UI, Segoe UI Emoji">
                                                    ⚡ Try: "Check all doors — find missing Fire Rating values and list by level" · "Duplicate this floor plan as dependent views for each Segment scope box" · "Create a door schedule, add Mark / Level / Fire Rating, sort by level"
                                                </TextBlock>
                                            </Border>
                                            <Border CornerRadius="6" Background="#0A7B61FF" Padding="12,8" Margin="0,8,0,0"
                                                    BorderBrush="#157B61FF" BorderThickness="1">
                                                <TextBlock TextWrapping="Wrap" Foreground="#50FFFFFF" FontSize="10.5" LineHeight="16"
                                                           FontFamily="Google Sans, Segoe UI Variable, Segoe UI, Segoe UI Emoji">
                                                    ⚠ No project standards loaded yet. Provide your BIM standards to the developer for integration. Session reports auto-export — your usage data shapes future development.
                                                </TextBlock>
                                            </Border>
                                            <!-- Step 8: WelcomeBriefingPanel (Discipline/Stats/Health/Suggestions)
                                                 removed — Model Health now lives in RightPanelControl. -->
                                        </StackPanel>
                                    </Border>

                                    <!-- Chat messages (MVVM): rendered via MessageTemplateSelector.
                                         Each container fades-in-up on Loaded (Step 8 entrance animation). -->
                                    <ItemsControl x:Name="MessageItems"
                                                  ItemsSource="{Binding Chat.Messages}"
                                                  ItemTemplateSelector="{StaticResource MessageTemplateSelector}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemContainerStyle>
                                            <Style TargetType="ContentPresenter">
                                                <Setter Property="views:Entrance.Animate" Value="True"/>
                                            </Style>
                                        </ItemsControl.ItemContainerStyle>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>

                            <!-- Status: blue pulse dot with breathing animation -->
                            <Border x:Name="StatusBar" Grid.Row="1" Background="#0AFFFFFF" Padding="18,8" Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal">
                                    <Border x:Name="StatusDot" Width="8" Height="8" CornerRadius="4" Background="#4D8EFE" VerticalAlignment="Center" Margin="0,0,10,0"
                                            RenderTransformOrigin="0.5,0.5">
                                        <Border.RenderTransform>
                                            <ScaleTransform x:Name="StatusDotScale" ScaleX="1" ScaleY="1"/>
                                        </Border.RenderTransform>
                                        <Border.Effect>
                                            <DropShadowEffect x:Name="StatusDotGlow" BlurRadius="10" ShadowDepth="0" Opacity="0.7" Color="#4D8EFE"/>
                                        </Border.Effect>
                                        <Border.Triggers>
                                            <EventTrigger RoutedEvent="Border.Loaded">
                                                <BeginStoryboard>
                                                    <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                        <!-- Step 8 breathing dot: opacity 0.4→1.0, scale 0.8→1.2, 2.0s ease-in-out -->
                                                        <DoubleAnimation Storyboard.TargetName="StatusDot"
                                                                         Storyboard.TargetProperty="Opacity"
                                                                         From="0.4" To="1.0" Duration="0:0:2.0">
                                                            <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                        <DoubleAnimation Storyboard.TargetName="StatusDotScale"
                                                                         Storyboard.TargetProperty="ScaleX"
                                                                         From="0.8" To="1.2" Duration="0:0:2.0">
                                                            <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                        <DoubleAnimation Storyboard.TargetName="StatusDotScale"
                                                                         Storyboard.TargetProperty="ScaleY"
                                                                         From="0.8" To="1.2" Duration="0:0:2.0">
                                                            <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                        <DoubleAnimation Storyboard.TargetName="StatusDotGlow"
                                                                         Storyboard.TargetProperty="BlurRadius"
                                                                         From="8" To="16" Duration="0:0:2.0">
                                                            <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </EventTrigger>
                                        </Border.Triggers>
                                    </Border>
                                    <TextBlock x:Name="StatusText" Text="Processing..." Foreground="{DynamicResource OnSurfaceVariantBrush}" FontSize="12"
                                               FontFamily="{DynamicResource BodyFont}"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        </Grid>
                    </Grid>

                    <!-- SELECTION INSPECTOR (above input bar) -->
                    <Border x:Name="SelectionInspectorBar" Grid.Row="3"
                            Background="#06FFFFFF" Padding="18,5" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="6" Height="6" CornerRadius="3" VerticalAlignment="Center"
                                    Margin="0,0,10,0">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#4285F4" Offset="0"/>
                                        <GradientStop Color="#7B61FF" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <TextBlock x:Name="SelectionInfoText" Text=""
                                       Foreground="#50FFFFFF" FontSize="12"
                                       TextTrimming="CharacterEllipsis"
                                       FontFamily="Google Sans, Segoe UI Variable, Segoe UI, Segoe UI Emoji"/>
                        </StackPanel>
                    </Border>

                    <!-- IMAGE PREVIEW + INPUT BAR (Step 4: extracted to InputBarControl) -->
                    <controls:InputBarControl Grid.Row="4" DataContext="{Binding Chat}"/>
                </Grid>
            </Grid>
        </Border>
    </Border>
</Window>
