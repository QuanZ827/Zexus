<UserControl x:Class="Zexus.Views.Controls.RightPanelControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Zexus.ViewModels"
             xmlns:conv="clr-namespace:Zexus.Views.Converters">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Zexus;component/Views/Templates/OutputCardTemplate.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
            <conv:ColorToBrushConverter x:Key="ColorToBrush"/>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Background="#06FFFFFF" BorderBrush="#0DFFFFFF" BorderThickness="1,0,0,0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36"/>     <!-- Health header -->
                <RowDefinition Height="Auto"/>    <!-- Health content -->
                <RowDefinition Height="4"/>      <!-- Horizontal splitter -->
                <RowDefinition Height="36"/>     <!-- Results header -->
                <RowDefinition Height="*"/>       <!-- Results list (scroll) -->
                <RowDefinition Height="Auto"/>    <!-- Journal footer -->
            </Grid.RowDefinitions>

            <!-- Model Health Header -->
            <Border Grid.Row="0" Background="#08FFFFFF" Padding="14,0">
                <Grid>
                    <TextBlock Text="MODEL HEALTH" FontSize="10" FontWeight="Medium"
                               Foreground="#8C909F"
                               FontFamily="Google Sans, Segoe UI Variable, Segoe UI"
                               VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Model Health Content -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="14,10" MaxHeight="280">
                <StackPanel>
                    <!-- Discipline -->
                    <Border Padding="10,8" Margin="0,0,0,6" CornerRadius="6"
                            Background="#08FFFFFF"
                            Visibility="{Binding HasDiscipline, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="{Binding DisciplineLabel}" FontSize="12" FontWeight="SemiBold"
                                       Foreground="#E8EAED"
                                       FontFamily="Google Sans, Segoe UI Variable, Segoe UI"/>
                            <TextBlock Text="{Binding TopCategoriesText}" FontSize="10.5"
                                       Foreground="#8C909F" Margin="0,3,0,0"
                                       TextWrapping="Wrap" LineHeight="16"
                                       FontFamily="Google Sans, Segoe UI Variable, Segoe UI"/>
                        </StackPanel>
                    </Border>

                    <!-- Stats -->
                    <Border Padding="10,8" Margin="0,0,0,6" CornerRadius="6" Background="#08FFFFFF">
                        <TextBlock Text="{Binding StatsLine}" FontSize="11" TextWrapping="Wrap"
                                   Foreground="#C2C6D5" LineHeight="16"
                                   FontFamily="Google Sans, Segoe UI Variable, Segoe UI"/>
                    </Border>

                    <!-- Health status card (clickable to expand warnings) -->
                    <Border Padding="10,8" Margin="0,0,0,6" CornerRadius="6"
                            Background="#0A000000" Cursor="Hand"
                            Visibility="{Binding HasHealthData, Converter={StaticResource BoolToVis}}">
                        <Border.InputBindings>
                            <MouseBinding MouseAction="LeftClick" Command="{Binding ToggleHealthCommand}"/>
                        </Border.InputBindings>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="8" Height="8" CornerRadius="4"
                                        Background="{Binding HealthDotColor, Converter={StaticResource ColorToBrush}}"
                                        VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding HealthText}" FontSize="11"
                                           Foreground="#C2C6D5" VerticalAlignment="Center"
                                           FontFamily="Google Sans, Segoe UI Variable, Segoe UI"/>
                            </StackPanel>

                            <!-- Expanded warning groups -->
                            <ItemsControl ItemsSource="{Binding WarningGroups}" Margin="0,8,0,0"
                                          Visibility="{Binding IsHealthExpanded, Converter={StaticResource BoolToVis}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="4" Padding="6,4" Margin="0,2,0,2"
                                                Background="#10FFFFFF" Cursor="Hand"
                                                Tag="{Binding Description}">
                                            <Border.InputBindings>
                                                <MouseBinding MouseAction="LeftClick"
                                                              Command="{Binding DataContext.WarningGroupClickCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                              CommandParameter="{Binding}"/>
                                            </Border.InputBindings>
                                            <StackPanel Orientation="Horizontal">
                                                <Border Width="6" Height="6" CornerRadius="3"
                                                        Margin="0,5,6,0" VerticalAlignment="Top">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#22C55E"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Severity}" Value="high">
                                                                    <Setter Property="Background" Value="#EF4444"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Severity}" Value="medium">
                                                                    <Setter Property="Background" Value="#F59E0B"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                </Border>
                                                <TextBlock FontSize="10" Foreground="#C2C6D5"
                                                           TextWrapping="Wrap" MaxWidth="320"
                                                           FontFamily="Google Sans, Segoe UI Variable, Segoe UI">
                                                    <Run Text="{Binding Description, Mode=OneWay}"/>
                                                    <Run Text=" ("/>
                                                    <Run Text="{Binding Count, Mode=OneWay}"/>
                                                    <Run Text=")"/>
                                                </TextBlock>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Suggestions -->
                    <Border Padding="10,8" CornerRadius="6"
                            Background="#0A7B61FF" BorderBrush="#157B61FF" BorderThickness="1"
                            Visibility="{Binding HasSuggestions, Converter={StaticResource BoolToVis}}">
                        <ItemsControl ItemsSource="{Binding Suggestions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" FontSize="10.5" Foreground="#8C909F"
                                               TextWrapping="Wrap" LineHeight="16"
                                               Margin="0,2,0,2"
                                               FontFamily="Google Sans, Segoe UI Variable, Segoe UI"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Horizontal Splitter (passive separator for now) -->
            <Border Grid.Row="2" Background="#10FFFFFF"/>

            <!-- Final Results Header -->
            <Border Grid.Row="3" Background="#08FFFFFF" Padding="14,0">
                <Grid>
                    <TextBlock Text="FINAL RESULTS" FontSize="10" FontWeight="Medium"
                               Foreground="#8C909F"
                               FontFamily="Google Sans, Segoe UI Variable, Segoe UI"
                               VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Output Records list -->
            <Grid Grid.Row="4">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10,8">
                    <ItemsControl ItemsSource="{Binding OutputRecords}"
                                  ItemTemplate="{StaticResource OutputCardTemplate}"/>
                </ScrollViewer>
                <TextBlock Text="No results yet"
                           Foreground="#5F6368" FontSize="11"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           FontFamily="Google Sans, Segoe UI Variable, Segoe UI"
                           Visibility="{Binding HasOutput, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}"/>
            </Grid>

            <!-- Journal footer -->
            <Border Grid.Row="5" Background="#10FFFFFF" Padding="14,8"
                    BorderBrush="#0DFFFFFF" BorderThickness="0,1,0,0">
                <TextBlock Text="{Binding JournalSummaryLine}" FontSize="10"
                           Foreground="#8C909F"
                           FontFamily="Google Sans, Segoe UI Variable, Segoe UI"/>
            </Border>
        </Grid>
    </Border>
</UserControl>
