<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:Zexus.ViewModels"
                    xmlns:models="clr-namespace:Zexus.Models"
                    xmlns:conv="clr-namespace:Zexus.Views.Converters">

    <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
    <conv:ColorToBrushConverter x:Key="ColorToBrush"/>

    <!-- ParameterChangeEntry row -->
    <DataTemplate x:Key="ParameterChangeEntryTemplate" DataType="{x:Type models:ParameterChangeEntry}">
        <Border Padding="6,3" Margin="0,2,0,2" CornerRadius="3"
                Background="{DynamicResource GlassPanelBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="{Binding ElementName}" FontSize="10.5"
                               Foreground="{DynamicResource OnSurfaceVariantBrush}"
                               FontFamily="{DynamicResource BodyFont}"
                               Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding OldValue}" FontSize="10"
                               Foreground="{DynamicResource OutlineBrush}" Margin="0,1,0,0"/>
                    <TextBlock Text="  -&gt;  " FontSize="10"
                               Foreground="{DynamicResource OutlineVariantBrush}" Margin="2,1,2,0"/>
                    <TextBlock Text="{Binding NewValue}" FontSize="10"
                               Foreground="{DynamicResource SuccessBrush}" Margin="0,1,0,0"/>
                </StackPanel>
                <TextBlock Grid.Column="1" Text="reverted" FontSize="9"
                           Foreground="{DynamicResource WarningBrush}"
                           VerticalAlignment="Center"
                           Visibility="{Binding IsReverted, Converter={StaticResource BoolToVis}}"/>
            </Grid>
        </Border>
    </DataTemplate>

    <!-- ScheduleChangeEntry row -->
    <DataTemplate x:Key="ScheduleChangeEntryTemplate" DataType="{x:Type models:ScheduleChangeEntry}">
        <Border Padding="6,3" Margin="0,2,0,2" CornerRadius="3"
                Background="{DynamicResource GlassPanelBrush}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding ChangeType}" FontSize="9"
                           Foreground="{DynamicResource OutlineBrush}"
                           FontWeight="SemiBold" Margin="0,0,6,0" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding FieldName}" FontSize="10.5"
                           Foreground="{DynamicResource OnSurfaceVariantBrush}"
                           FontFamily="{DynamicResource BodyFont}" Margin="0,0,6,0"/>
                <TextBlock Text="{Binding Action}" FontSize="10"
                           Foreground="{DynamicResource SuccessBrush}" Margin="0,1,6,0"/>
                <TextBlock Text="{Binding Detail}" FontSize="10"
                           Foreground="{DynamicResource OutlineBrush}" Margin="0,1,0,0"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="  reverted" FontSize="9"
                           Foreground="{DynamicResource WarningBrush}" Margin="6,1,0,0"
                           Visibility="{Binding IsReverted, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>
        </Border>
    </DataTemplate>

    <!--
        Stitch OutputCard:
        - Left 2px accent border, color varies by RecordType
        - 32×32 icon container, rounded-lg, tinted background
        - "Open in Revit" link, Undo ghost button
    -->
    <DataTemplate x:Key="OutputCardTemplate" DataType="{x:Type vm:OutputRecordViewModel}">
        <Border CornerRadius="12" Padding="14,12,14,12" Margin="0,0,0,8"
                Background="{DynamicResource GlassPanelBrush}"
                BorderThickness="2,1,1,1">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Opacity" Value="1"/>
                    <!-- Default left accent = primary; overridden per RecordType below. -->
                    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryContainerBrush}"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding RecordType}" Value="ParameterSet">
                            <Setter Property="BorderBrush" Value="{DynamicResource SecondaryContainerBrush}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding RecordType}" Value="ParameterCreated">
                            <Setter Property="BorderBrush" Value="{DynamicResource SecondaryContainerBrush}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding RecordType}" Value="ViewCreated">
                            <Setter Property="BorderBrush" Value="{DynamicResource TertiaryContainerBrush}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding RecordType}" Value="ViewModified">
                            <Setter Property="BorderBrush" Value="{DynamicResource TertiaryContainerBrush}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding RecordType}" Value="FileExported">
                            <Setter Property="BorderBrush" Value="{DynamicResource SuccessBrush}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding RecordType}" Value="FilePrinted">
                            <Setter Property="BorderBrush" Value="{DynamicResource SuccessBrush}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsFullyReverted}" Value="True">
                            <Setter Property="Opacity" Value="0.5"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <StackPanel>
                <!-- Header row: 32x32 icon + title/subtitle + time + Undo -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="32"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="28" Height="28" CornerRadius="8"
                            VerticalAlignment="Top"
                            Background="{Binding IconColor, Converter={StaticResource ColorToBrush}, ConverterParameter=#28}">
                        <TextBlock Text="{Binding IconGlyph}" FontSize="14"
                                   FontFamily="{DynamicResource BodyFont}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{Binding IconColor, Converter={StaticResource ColorToBrush}}"/>
                    </Border>

                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource OnSurfaceBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   FontFamily="{DynamicResource BodyFont}"/>
                        <TextBlock Text="{Binding Subtitle}" FontSize="11"
                                   Foreground="{DynamicResource OutlineBrush}"
                                   TextWrapping="Wrap" Margin="0,1,0,0"
                                   FontFamily="{DynamicResource BodyFont}"/>
                    </StackPanel>

                    <TextBlock Grid.Column="2" Text="{Binding TimeStamp}" FontSize="10"
                               Foreground="{DynamicResource OutlineVariantBrush}"
                               VerticalAlignment="Top" Margin="6,2,0,0"
                               FontFamily="{DynamicResource BodyFont}"/>

                    <Button Grid.Column="3" Content="Undo" FontSize="9"
                            Margin="8,0,0,0" Padding="8,3"
                            Background="Transparent"
                            Foreground="{DynamicResource WarningBrush}"
                            BorderBrush="{DynamicResource OutlineVariantBrush}" BorderThickness="1"
                            Command="{Binding UndoCommand}"
                            Visibility="{Binding CanUndo, Converter={StaticResource BoolToVis}}"
                            VerticalAlignment="Top" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border CornerRadius="4" Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>

                <!-- Action row -->
                <StackPanel Orientation="Horizontal" Margin="42,8,0,0">
                    <Button Command="{Binding ToggleExpandCommand}"
                            Visibility="{Binding IsExpandable, Converter={StaticResource BoolToVis}}"
                            Background="Transparent" BorderThickness="0" Cursor="Hand"
                            Foreground="{DynamicResource OutlineBrush}" FontSize="10" Padding="0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            </ControlTemplate>
                        </Button.Template>
                        <TextBlock>
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="show details"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                            <Setter Property="Text" Value="hide details"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Button>

                    <Button Command="{Binding NavigateCommand}"
                            Visibility="{Binding CanOpenInRevit, Converter={StaticResource BoolToVis}}"
                            Background="Transparent" BorderThickness="0" Cursor="Hand"
                            Foreground="{DynamicResource PrimaryContainerBrush}" FontSize="10"
                            Padding="0" Margin="14,0,0,0" Content="open in Revit">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>

                <!-- Expanded details -->
                <StackPanel Margin="42,8,0,0"
                            Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}">
                    <ItemsControl ItemsSource="{Binding ChangeEntries}"
                                  ItemTemplate="{StaticResource ParameterChangeEntryTemplate}"/>
                    <ItemsControl ItemsSource="{Binding ScheduleChangeEntries}"
                                  ItemTemplate="{StaticResource ScheduleChangeEntryTemplate}"/>
                </StackPanel>
            </StackPanel>

        </Border>
    </DataTemplate>

</ResourceDictionary>
