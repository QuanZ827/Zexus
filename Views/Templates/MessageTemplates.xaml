<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:Zexus.ViewModels"
                    xmlns:conv="clr-namespace:Zexus.Views.Converters">

    <!--
        Step 7: Stitch glassmorphism + M3 DynamicResource.
        User    = gradient fill, rounded-tr-sm  (CornerRadius 8,2,8,8)
        Agent   = glass + 2px primary left accent, rounded-bl-sm (CornerRadius 8,8,8,2)
        System  = centered, muted, glass
    -->

    <conv:BoolToVisibilityConverter x:Key="BoolToVisibility"/>

    <!-- Selectable body text inside bubbles -->
    <Style x:Key="BubbleBodyTextStyle" TargetType="TextBox">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="IsReadOnly" Value="True"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontFamily" Value="{DynamicResource BodyFont}"/>
        <Setter Property="Foreground" Value="{DynamicResource OnSurfaceBrush}"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="CaretBrush" Value="Transparent"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource PrimaryContainerBrush}"/>
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="Cursor" Value="IBeam"/>
    </Style>

    <!-- Tool-call dot — status-colored via DataTriggers -->
    <Style x:Key="ToolDotStyle" TargetType="Border">
        <Setter Property="Width" Value="6"/>
        <Setter Property="Height" Value="6"/>
        <Setter Property="CornerRadius" Value="3"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,0,6,0"/>
        <Setter Property="Background" Value="{DynamicResource WarningBrush}"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Status}" Value="Completed">
                <Setter Property="Background" Value="{DynamicResource SuccessBrush}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Status}" Value="Failed">
                <Setter Property="Background" Value="{DynamicResource ErrorBrush}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ToolNameStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontFamily" Value="{DynamicResource BodyFont}"/>
        <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Status}" Value="Completed">
                <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Status}" Value="Failed">
                <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- USER BUBBLE: gradient, asymmetric top-right -->
    <DataTemplate x:Key="UserBubbleTemplate">
        <Border CornerRadius="8,2,8,8" Padding="16,14" Margin="100,3,0,6"
                HorizontalAlignment="Right" BorderThickness="1"
                MaxWidth="640"
                Background="{DynamicResource UserBubbleGradientBrush}"
                BorderBrush="{DynamicResource PrimaryTint20Brush}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="0" Opacity="0.10" Color="#000000"/>
            </Border.Effect>
            <StackPanel>
                <TextBlock Text="YOU" FontSize="10" FontWeight="Medium"
                           Foreground="{DynamicResource PrimaryBrush}" Margin="0,0,0,6"
                           Typography.Capitals="AllSmallCaps"
                           FontFamily="{DynamicResource LabelFont}"/>
                <TextBox Style="{StaticResource BubbleBodyTextStyle}"
                         Text="{Binding Content, Mode=OneWay}"/>
            </StackPanel>
        </Border>
    </DataTemplate>

    <!-- AGENT BUBBLE: glass + 2px left primary accent, asymmetric bottom-left -->
    <DataTemplate x:Key="AgentBubbleTemplate">
        <Border CornerRadius="8,8,8,2" Padding="16,14" Margin="0,3,80,6"
                HorizontalAlignment="Left"
                MaxWidth="720"
                Background="{DynamicResource GlassPanelBrush}"
                BorderBrush="{DynamicResource PrimaryContainerBrush}"
                BorderThickness="2,1,1,1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="0" Opacity="0.10" Color="#000000"/>
            </Border.Effect>
            <StackPanel>
                <TextBlock Text="AGENT" FontSize="10" FontWeight="Medium"
                           Foreground="{DynamicResource PrimaryContainerBrush}" Margin="0,0,0,6"
                           Typography.Capitals="AllSmallCaps"
                           FontFamily="{DynamicResource LabelFont}"/>

                <!-- Tool call indicators -->
                <ItemsControl ItemsSource="{Binding ToolCalls}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <Border Style="{StaticResource ToolDotStyle}"/>
                                <TextBlock Text="{Binding Name}"
                                           Style="{StaticResource ToolNameStyle}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Body text -->
                <TextBox Style="{StaticResource BubbleBodyTextStyle}"
                         Text="{Binding Content, Mode=OneWay}"/>

                <!-- Inline status (collapsed Workspace Panel) -->
                <Border Visibility="{Binding ShowInlineStatus, Converter={StaticResource BoolToVisibility}}"
                        CornerRadius="4" Padding="8,6" Margin="0,8,0,0"
                        Background="#26000000" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1">
                    <StackPanel>
                        <DockPanel>
                            <Button DockPanel.Dock="Right"
                                    Command="{Binding ToggleLogsCommand}"
                                    Background="Transparent" BorderThickness="0"
                                    Cursor="Hand" Foreground="{DynamicResource OutlineBrush}"
                                    FontSize="9" Padding="0">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <ContentPresenter HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </ControlTemplate>
                                </Button.Template>
                                <TextBlock>
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="show logs"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsLogsExpanded}" Value="True">
                                                    <Setter Property="Text" Value="hide logs"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Button>
                            <!-- Spinner glyph — rotates while streaming, hidden once done -->
                            <TextBlock x:Name="SpinnerGlyph" DockPanel.Dock="Left"
                                       Text="&#xE72C;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="12" Margin="0,0,6,0"
                                       Foreground="{DynamicResource PrimaryContainerBrush}"
                                       VerticalAlignment="Center"
                                       RenderTransformOrigin="0.5,0.5"
                                       Visibility="{Binding IsStreaming, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock.RenderTransform>
                                    <RotateTransform Angle="0"/>
                                </TextBlock.RenderTransform>
                                <TextBlock.Triggers>
                                    <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                        <BeginStoryboard>
                                            <Storyboard RepeatBehavior="Forever">
                                                <DoubleAnimation
                                                    Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                    From="0" To="360" Duration="0:0:1.5"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </TextBlock.Triggers>
                            </TextBlock>
                            <TextBlock Text="{Binding InlineStatusText}" FontSize="11"
                                       Foreground="{DynamicResource OnSurfaceVariantBrush}"
                                       VerticalAlignment="Center"
                                       FontFamily="{DynamicResource BodyFont}"/>
                        </DockPanel>

                        <!-- Expanded thinking chain nodes -->
                        <ItemsControl ItemsSource="{Binding ThinkingNodes}"
                                      Visibility="{Binding IsLogsExpanded, Converter={StaticResource BoolToVisibility}}"
                                      Margin="0,6,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2,0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="14"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0"
                                                Width="6" Height="6" CornerRadius="3"
                                                Margin="0,5,0,0" VerticalAlignment="Top"
                                                HorizontalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{DynamicResource WarningBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="Completed">
                                                            <Setter Property="Background" Value="{DynamicResource SuccessBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Failed">
                                                            <Setter Property="Background" Value="{DynamicResource ErrorBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>

                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Title}" FontSize="10.5"
                                                       Foreground="{DynamicResource OnSurfaceVariantBrush}"
                                                       TextWrapping="Wrap"
                                                       FontFamily="{DynamicResource BodyFont}"/>
                                            <TextBlock Text="{Binding Subtitle}" FontSize="9.5"
                                                       Foreground="{DynamicResource OutlineBrush}"
                                                       TextWrapping="Wrap" MaxWidth="420"
                                                       FontFamily="{DynamicResource BodyFont}"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>
    </DataTemplate>

    <!-- SYSTEM MESSAGE -->
    <DataTemplate x:Key="SystemMessageTemplate">
        <Border CornerRadius="10" Padding="14,10" Margin="40,4,40,10"
                Background="{DynamicResource GlassPanelBrush}"
                BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1"
                HorizontalAlignment="Center" MaxWidth="640">
            <TextBlock Text="{Binding Content}" FontSize="12"
                       Foreground="{DynamicResource OutlineBrush}" TextAlignment="Center"
                       TextWrapping="Wrap"
                       FontFamily="{DynamicResource BodyFont}"/>
        </Border>
    </DataTemplate>

    <!-- Template selector instance — used by ItemsControl.ItemTemplateSelector -->
    <conv:MessageTemplateSelector x:Key="MessageTemplateSelector"
                                  UserTemplate="{StaticResource UserBubbleTemplate}"
                                  AgentTemplate="{StaticResource AgentBubbleTemplate}"
                                  SystemTemplate="{StaticResource SystemMessageTemplate}"/>

</ResourceDictionary>
